# Headers aplicados pela Cloudflare aos arquivos estáticos (copiado para a saída pelo adapter).

# Segurança: o site não tem JavaScript próprio, então a política fica fechada. A única exceção é o
# beacon do Cloudflare Web Analytics, injetado pela borda (script em static.cloudflareinsights.com,
# envio das métricas para /cdn-cgi/rum ou cloudflareinsights.com). data: cobre o ícone SVG do WhatsApp
# e media-src 'self' o vídeo de fundo do hero.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'none'; script-src https://static.cloudflareinsights.com; img-src 'self' data:; media-src 'self'; style-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Imagens, vídeos e ícones mudam raramente
/images/*
  Cache-Control: public, max-age=2592000
/videos/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon.png
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# Versão publicada (usada pelo workflow do IndexNow): nunca em cache
/versao.txt
  Cache-Control: no-store

# Currículo: consolida os sinais de busca na página de recrutadores
/curriculo-calebe-araujo.pdf
  Cache-Control: public, max-age=86400
  Link: <https://calebearaujo.com.br/desenvolvedor-full-stack-sorocaba>; rel="canonical"
