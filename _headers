# Headers aplicados pela Cloudflare aos arquivos estáticos (copiado para a saída pelo adapter).

# Segurança: o site não carrega JavaScript nem recursos de terceiros, então a política pode ser fechada
# (CSS só do próprio domínio; data: para o ícone SVG do botão de WhatsApp)
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Imagens e ícones mudam raramente
/images/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# Currículo: consolida os sinais de busca na página de recrutadores
/curriculo-calebe-araujo.pdf
  Cache-Control: public, max-age=86400
  Link: <https://calebearaujo.com.br/desenvolvedor-full-stack-sorocaba>; rel="canonical"
