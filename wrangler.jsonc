{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Nome do projeto no Cloudflare Pages (define o subdomínio <name>.pages.dev)
	"name": "calebe-dev",
	"compatibility_date": "2026-10-01",
	// AsyncLocalStorage é usado pelo SvelteKit (getRequestEvent)
	"compatibility_flags": ["nodejs_als"],
	// Saída gerada pelo @sveltejs/adapter-cloudflare
	"pages_build_output_dir": ".svelte-kit/cloudflare"
}
