{
	"name": "sveltekit-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"fetch-favicons": "node ./scripts/fetch-favicons.js",
		"generate-sitemap": "node ./scripts/generate-sitemap.js",
		"build": "vite build",
		"preview": "npm run build && wrangler pages dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"post:new": "node ./scripts/cms.js new",
		"post:list": "node ./scripts/cms.js list",
		"deploy": "npm run build && wrangler pages deploy",
		"rollback": "node ./scripts/rollback.js",
		"cf-typegen": "wrangler types src/worker-configuration.d.ts --include-runtime=false"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@types/aos": "^3.0.7",
		"autoprefixer": "^10.4.23",
		"mdsvex": "^0.12.7",
		"postcss": "^8.5.6",
		"sass": "^1.94.1",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"wrangler": "^4.152.0"
	},
	"dependencies": {
		"@emailjs/browser": "^4.4.1",
		"@fortawesome/free-brands-svg-icons": "^7.1.0",
		"@fortawesome/free-solid-svg-icons": "^7.1.0",
		"aos": "^2.3.4",
		"lenis": "^1.3.18",
		"svelte-fa": "^4.0.4"
	}
}
